// prisma/schema.prisma
// Valid status values: "PENDING" | "WIN" | "LOSS" | "VOID"

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model BetDouble {
  id         Int            @id @default(autoincrement())
  date       String         @unique
  totalOdds  Float
  status     String         @default("PENDING")
  createdAt  DateTime       @default(now())
  updatedAt  DateTime       @updatedAt
  selections BetSelection[]
}

model BetSelection {
  id           Int       @id @default(autoincrement())
  doubleId     Int
  double       BetDouble @relation(fields: [doubleId], references: [id], onDelete: Cascade)
  homeTeam     String
  awayTeam     String
  market       String
  line         Float?
  odd          Float
  league       String
  country      String
  kickoff      String
  resultStatus String    @default("PENDING")
  homeScore    Int?
  awayScore    Int?
  scrapedAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
}

// Legacy: Facebook tickets were removed from the app; tables kept so old data is not lost.
model FbTicket {
  id         Int           @id @default(autoincrement())
  date       String        @unique
  postId     String?
  totalOdds  Float
  status     String        @default("PENDING")
  scrapedAt  DateTime      @default(now())
  updatedAt  DateTime      @updatedAt
  selections FbSelection[]
}

model FbSelection {
  id       Int      @id @default(autoincrement())
  ticketId Int
  ticket   FbTicket @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  kickoff  String
  homeTeam String
  awayTeam String
  market   String
  odd      Float
}

model FstTip {
  id        Int      @id @default(autoincrement())
  date      String   @unique
  homeTeam  String
  awayTeam  String
  pick      String
  market    String
  kickoff   String
  odd       Float    @default(0)
  status    String   @default("PENDING")
  homeScore Int?
  awayScore Int?
  scrapedAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model FtTip {
  id        Int      @id @default(autoincrement())
  date      String   @unique
  homeTeam  String
  awayTeam  String
  pick      String
  market    String
  kickoff   String
  odd       Float    @default(0)
  status    String   @default("PENDING")
  homeScore Int?
  awayScore Int?
  scrapedAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// Tips from third-party tipster sites (source = "FOREBET" | "TIPORACLE"), several picks per day.
model ExtTip {
  id         Int      @id @default(autoincrement())
  source     String
  date       String
  rank       Int
  homeTeam   String
  awayTeam   String
  league     String   @default("")
  market     String
  pick       String
  kickoff    String   @default("")
  odd        Float    @default(0)
  confidence Int?
  sourceUrl  String?
  legs       String?  // JSON array for multi-match tickets (trebles); null for single tips
  status     String   @default("PENDING")
  homeScore  Int?
  awayScore  Int?
  scrapedAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@unique([source, date, rank])
  @@index([source, status])
}

// Audit log of match scores found by the Gemini web-search fallback (two agreeing votes + source URLs).
model LlmScore {
  id         Int      @id @default(autoincrement())
  homeTeam   String
  awayTeam   String
  date       String
  homeScore  Int
  awayScore  Int
  sources    String   // JSON array of source URLs reported by the search grounding
  models     String   // JSON array of the models that voted
  createdAt  DateTime @default(now())

  @@index([date])
}

// Shared cache of SportsAPIPro day schedules (slim: teams, score, status), so the 100 calls/day free quota lasts.
model ScheduleCache {
  date      String   @id
  matches   String   // JSON array of [home, away, homeScore, awayScore, statusType]
  fetchedAt DateTime @default(now())
}
